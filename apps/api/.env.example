# ---- Server ----
PORT=4000
WEB_ORIGIN=http://localhost:3000
ML_SERVICE_URL=http://127.0.0.1:8001
MAX_FILE_MB=5

# ---- Supabase (opsional) ----
# Kosongkan SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY untuk MODE DEMO
# (data disimpan di apps/api/data/db.json + storage lokal).
#
# Salin file ini menjadi .env lalu isi nilai asli di sana. JANGAN isi nilai
# asli di file ini: .env.example ikut dibagikan/dikumpulkan.
#
# Key baru Supabase:
#   sb_publishable_... -> SUPABASE_ANON_KEY        (aman untuk browser)
#   sb_secret_...      -> SUPABASE_SERVICE_ROLE_KEY (server saja, JANGAN ke frontend)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxx
SUPABASE_BUCKET=resumes

# Biarkan kosong. Isi 1 hanya bila ingin memaksa mode demo walau Supabase terisi.
DEMO_MODE=
