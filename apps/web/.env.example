# URL Express API (dipakai untuk proxy /api/* saat development)
API_URL=http://localhost:4000

# Supabase (opsional). Kosongkan keduanya untuk MODE DEMO tanpa login.
# Salin file ini menjadi .env.local dan isi nilai asli di sana — jangan di sini.
# Publishable key (sb_publishable_...) aman untuk browser; secret key hanya di API.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx
